@inject PluginManager Manager
@inject QueryDispatcher Dispatcher
@inject IWindowController Window

<div class="pane-root" @onkeydown="OnKeyDown" tabindex="-1">
    @if (_showSettings)
    {
        <SettingsPage />
    }
    else
    {
        <div class="pane-search-row">
            <svg class="pane-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
            <input class="pane-search"
                   value="@_text"
                   @oninput="OnInput"
                   placeholder="Search apps, repos, scripts, math…"
                   autofocus
                   spellcheck="false"
                   autocomplete="off" />
        </div>

        @if (_results.Count > 0)
        {
            <div class="pane-body">
                <ResultList Results="_results" Selected="_selected" />
            </div>
            <div class="pane-footer">
                <span class="pane-count">@_results.Count result@(_results.Count == 1 ? "" : "s")</span>
                <span class="pane-hints">
                    <kbd>↑</kbd><kbd>↓</kbd> navigate
                    <kbd>↵</kbd> open
                    <kbd>esc</kbd> close
                </span>
            </div>
        }
        else
        {
            <div class="pane-empty">
                @if (string.IsNullOrWhiteSpace(_text))
                {
                    <span>Start typing to search — or type <b>settings</b> to manage plugins.</span>
                }
                else
                {
                    <span>No results for “@_text”.</span>
                }
            </div>
        }
    }
</div>

@code {
    string _text = "";
    int _selected;
    bool _showSettings;
    IReadOnlyList<ScoredResult> _results = Array.Empty<ScoredResult>();
    CancellationTokenSource? _cts;

    // Populate with everything on open (Raycast-style), so the launcher is
    // immediately useful and empty-query results rank by BaseScore.
    protected override async Task OnInitializedAsync() => await RunQuery();

    async Task OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";

        if (_text.Trim().Equals("settings", StringComparison.OrdinalIgnoreCase))
        {
            _showSettings = true;
            _text = "";
            _results = Array.Empty<ScoredResult>();
            return;
        }

        await RunQuery();
    }

    async Task RunQuery()
    {
        var old = _cts;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        old?.Cancel();
        old?.Dispose();

        var plugins = Manager.List()
            .Where(e => e.State == PluginState.Enabled && e.Instance is not null)
            .Select(e => (e.Metadata, e.Instance!))
            .ToList();

        try
        {
            _results = await Dispatcher.DispatchAsync(_text, plugins, token);
            _selected = 0;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                if (_showSettings)
                {
                    _showSettings = false;
                    _text = "";
                    _results = Array.Empty<ScoredResult>();
                }
                else
                {
                    // Spotlight-style: Escape dismisses the launcher.
                    _text = "";
                    await RunQuery();
                    Window.Hide();
                }
                break;
            case "ArrowDown":
                if (!_showSettings && _results.Count > 0)
                    _selected = Math.Min(_selected + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                if (!_showSettings && _results.Count > 0)
                    _selected = Math.Max(_selected - 1, 0);
                break;
            case "Enter":
                if (!_showSettings && _selected >= 0 && _selected < _results.Count)
                    await _results[_selected].Result.Activate();
                break;
        }
    }
}
