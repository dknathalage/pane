@inject QueryDispatcher Dispatcher
@inject IWindowController Window
@inject IFuzzyMatcher Fuzzy
@inject IJSRuntime JS
@implements IDisposable

<div class="pane-root" @onkeydown="OnKeyDown" tabindex="-1">
    @if (_showSettings)
    {
        <SettingsPage OnBack="CloseSettings" />
    }
    else
    {
        <div class="pane-search-row">
            <svg class="pane-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
            <input class="pane-search"
                   @ref="_input"
                   value="@_text"
                   @oninput="OnInput"
                   placeholder="Search apps, repos, scripts, math…"
                   autofocus
                   spellcheck="false"
                   autocomplete="off" />
        </div>

        @if (_results.Count > 0)
        {
            <div class="pane-body">
                <ResultList Results="_results" Selected="_selected" />
            </div>
            <div class="pane-footer">
                <span class="pane-count">@_results.Count result@(_results.Count == 1 ? "" : "s")</span>
                <span class="pane-hints">
                    <kbd>↑</kbd><kbd>↓</kbd> navigate
                    <kbd>↵</kbd> open
                    <kbd>⌘</kbd><kbd>,</kbd> settings
                    <kbd>esc</kbd> close
                </span>
            </div>
        }
        else
        {
            <div class="pane-empty">
                @if (string.IsNullOrWhiteSpace(_text))
                {
                    <span>Start typing to search — or type <b>settings</b> (or press <kbd>⌘</kbd><kbd>,</kbd>) to manage features.</span>
                }
                else
                {
                    <span>No results for “@_text”.</span>
                }
            </div>
        }
    }
</div>

@code {
    // The Settings screen is reached like any other result: search "settings"
    // (or the ⌘, shortcut). No dedicated button.
    static readonly BuiltinCommand SettingsCommand =
        new("settings", "Settings", "Manage features",
            new[] { "settings", "preferences", "config" });

    string _text = "";
    int _selected;
    bool _showSettings;
    IReadOnlyList<ScoredResult> _results = Array.Empty<ScoredResult>();
    CancellationTokenSource? _cts;

    ElementReference _input;
    DotNetObjectReference<Launcher>? _self;
    bool _jsInitialized;

    // Populate with everything on open (Raycast-style), so the launcher is
    // immediately useful and empty-query results rank by BaseScore.
    protected override async Task OnInitializedAsync() => await RunQuery();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("paneWindow.init", _self);
            _jsInitialized = true;
        }
        // Keep the search box focused whenever we're on the launcher view.
        if (_jsInitialized && !_showSettings)
            await JS.InvokeVoidAsync("paneWindow.focus");
    }

    /// <summary>JS callback: the rendered content is this tall — size the window to fit.</summary>
    [JSInvokable]
    public void OnContentResized(int height) => Window.SetHeight(height);

    /// <summary>JS callback: the window lost focus — dismiss the overlay (Spotlight-style).</summary>
    [JSInvokable]
    public void OnWindowBlur() => Window.Hide();

    void OpenSettings()
    {
        _showSettings = true;
        _text = "";
        _results = Array.Empty<ScoredResult>();
    }

    void CloseSettings()
    {
        _showSettings = false;
        _text = "";
        _results = Array.Empty<ScoredResult>();
    }

    async Task OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        await RunQuery();
    }

    async Task RunQuery()
    {
        var old = _cts;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        old?.Cancel();
        old?.Dispose();

        try
        {
            var results = (await Dispatcher.DispatchAsync(_text, token)).ToList();
            AddSettingsResult(results);
            _results = results;
            _selected = 0;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    // Merge the built-in "Settings" command into the ranked plugin results.
    void AddSettingsResult(List<ScoredResult> results)
    {
        var score = SettingsCommand.Score(_text, Fuzzy, out var highlights);
        if (score is null) return;

        var result = new PaneResult(
            SettingsCommand.Title, SettingsCommand.Subtitle, "", 0,
            () => { OpenSettings(); return Task.CompletedTask; });

        results.Add(new ScoredResult(result, score.Value, highlights, SettingsCommand.Id));
        results.Sort((a, b) => b.Score.CompareTo(a.Score));
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        // ⌘, (macOS) / Ctrl+, — standard "open settings" shortcut.
        if (e.Key == "," && (e.MetaKey || e.CtrlKey))
        {
            if (!_showSettings) OpenSettings();
            return;
        }

        switch (e.Key)
        {
            case "Escape":
                if (_showSettings)
                {
                    CloseSettings();
                }
                else
                {
                    // Spotlight-style: Escape dismisses the launcher.
                    _text = "";
                    await RunQuery();
                    Window.Hide();
                }
                break;
            case "ArrowDown":
                if (!_showSettings && _results.Count > 0)
                    _selected = Math.Min(_selected + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                if (!_showSettings && _results.Count > 0)
                    _selected = Math.Max(_selected - 1, 0);
                break;
            case "Enter":
                if (!_showSettings && _selected >= 0 && _selected < _results.Count)
                    await _results[_selected].Result.Activate();
                break;
        }
    }

    public void Dispose() => _self?.Dispose();
}
