@using Pane.Core.Query

<ul class="pane-results">
    @for (int i = 0; i < Results.Count; i++)
    {
        var r = Results[i];
        var isSel = i == Selected;
        var icon = r.Result.Icon ?? "";
        <li class="pane-item @(isSel ? "sel" : "")">
            <span class="pane-icon @(IsImage(icon) ? "img" : "")">
                @if (IsImage(icon))
                {
                    <img src="@icon" alt="" />
                }
                else
                {
                    @IconFor(r.PluginId, icon)
                }
            </span>
            <span class="pane-text">
                <span class="pane-title">@Highlight(r.Result.Title, r.TitleHighlights)</span>
                @if (!string.IsNullOrEmpty(r.Result.Subtitle))
                {
                    <span class="pane-subtitle">@r.Result.Subtitle</span>
                }
            </span>
            <span class="pane-action">@ActionFor(r.PluginId)</span>
            @if (isSel)
            {
                <span class="pane-enter">↵</span>
            }
        </li>
    }
</ul>

@code {
    [Parameter] public IReadOnlyList<ScoredResult> Results { get; set; } = Array.Empty<ScoredResult>();
    [Parameter] public int Selected { get; set; }

    static bool IsImage(string icon) =>
        icon.StartsWith("data:") || icon.StartsWith("file:") || icon.StartsWith("/");

    // What pressing Enter will do — shown on every row.
    static string ActionFor(string pluginId) => pluginId switch
    {
        "vscode"  => "Open in VSCode",
        "apps"    => "Launch",
        "scripts" => "Run script",
        "calc"    => "Copy",
        _         => "Open",
    };

    static MarkupString Highlight(string text, IReadOnlyList<int> positions)
    {
        if (positions.Count == 0)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var set = new HashSet<int>(positions);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < text.Length; i++)
        {
            var c = System.Net.WebUtility.HtmlEncode(text[i].ToString());
            sb.Append(set.Contains(i) ? $"<mark>{c}</mark>" : c);
        }
        return (MarkupString)sb.ToString();
    }

    // Non-image icon: per-item emoji where the plugin provides one (scripts),
    // else a crisp plugin-type SVG.
    static MarkupString IconFor(string pluginId, string icon) => pluginId switch
    {
        "vscode"   => FolderSvg,
        "calc"     => CalcSvg,
        "apps"     => GridSvg,
        "settings" => GearSvg,
        "scripts"  => string.IsNullOrEmpty(icon) ? TerminalSvg : Emoji(icon),
        _          => string.IsNullOrEmpty(icon) ? DotSvg : Emoji(icon),
    };

    static MarkupString Emoji(string s) => (MarkupString)System.Net.WebUtility.HtmlEncode(s);

    static readonly MarkupString FolderSvg =
        Svg("<path d=\"M3 7a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.4.6L12 7h5a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>");
    static readonly MarkupString GridSvg =
        Svg("<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>");
    static readonly MarkupString TerminalSvg =
        Svg("<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"m7 9 3 3-3 3\"/><line x1=\"13\" y1=\"15\" x2=\"17\" y2=\"15\"/>");
    static readonly MarkupString CalcSvg =
        Svg("<rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"/><line x1=\"8\" y1=\"6\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"11\" x2=\"9\" y2=\"11\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"11\"/><line x1=\"15\" y1=\"11\" x2=\"16\" y2=\"11\"/><line x1=\"8\" y1=\"15\" x2=\"9\" y2=\"15\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"15\"/><line x1=\"8\" y1=\"18\" x2=\"9\" y2=\"18\"/>");
    static readonly MarkupString DotSvg = Svg("<circle cx=\"12\" cy=\"12\" r=\"3\"/>");
    static readonly MarkupString GearSvg = Svg(
        "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/>");

    static MarkupString Svg(string inner) => (MarkupString)
        $"<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{inner}</svg>";
}
