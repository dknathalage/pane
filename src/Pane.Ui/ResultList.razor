@using Pane.Core.Query

<ul class="pane-results">
    @for (int i = 0; i < Results.Count; i++)
    {
        var r = Results[i];
        var isSel = i == Selected;
        <li class="pane-item @(isSel ? "sel" : "")">
            <span class="pane-icon">@IconFor(r.PluginId, r.Result.Icon)</span>
            <span class="pane-text">
                <span class="pane-title">@Highlight(r.Result.Title, r.TitleHighlights)</span>
                @if (!string.IsNullOrEmpty(r.Result.Subtitle))
                {
                    <span class="pane-subtitle">@r.Result.Subtitle</span>
                }
            </span>
            @if (isSel)
            {
                <span class="pane-enter">↵</span>
            }
        </li>
    }
</ul>

@code {
    [Parameter] public IReadOnlyList<ScoredResult> Results { get; set; } = Array.Empty<ScoredResult>();
    [Parameter] public int Selected { get; set; }

    static MarkupString Highlight(string text, IReadOnlyList<int> positions)
    {
        if (positions.Count == 0)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var set = new HashSet<int>(positions);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < text.Length; i++)
        {
            var c = System.Net.WebUtility.HtmlEncode(text[i].ToString());
            sb.Append(set.Contains(i) ? $"<mark>{c}</mark>" : c);
        }
        return (MarkupString)sb.ToString();
    }

    // Crisp inline-SVG icons keyed by plugin id; fall back to the plugin's emoji.
    static MarkupString IconFor(string pluginId, string emoji) => pluginId switch
    {
        "vscode" => Svg("<path d=\"M3 7a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.4.6L12 7h5a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>"),
        "apps" => Svg("<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>"),
        "scripts" => Svg("<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"m7 9 3 3-3 3\"/><line x1=\"13\" y1=\"15\" x2=\"17\" y2=\"15\"/>"),
        "calc" => Svg("<rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"/><line x1=\"8\" y1=\"6\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"11\" x2=\"9\" y2=\"11\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"11\"/><line x1=\"15\" y1=\"11\" x2=\"16\" y2=\"11\"/><line x1=\"8\" y1=\"15\" x2=\"9\" y2=\"15\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"15\"/><line x1=\"8\" y1=\"18\" x2=\"9\" y2=\"18\"/>"),
        _ => (MarkupString)System.Net.WebUtility.HtmlEncode(string.IsNullOrEmpty(emoji) ? "•" : emoji),
    };

    static MarkupString Svg(string inner) => (MarkupString)
        $"<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{inner}</svg>";
}
